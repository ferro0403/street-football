{
  "name": "street-football",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Calcio di strada 5 contro 5 in gabbia, isometrico retro, nel browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sprites": "tsx scripts/sprites/generate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
